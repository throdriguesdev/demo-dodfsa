    {
      "title": "Order Flow",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Orders Created / Completed / Failed / Cancelled per Minute",
      "description": "Order lifecycle events over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "sum(rate(orders_created_total{job=\"demo-api\"}[$__rate_interval])) * 60",
          "legendFormat": "Created",
          "refId": "A",
          "exemplar": true
        },
        {
          "expr": "sum(rate(orders_completed_total{job=\"demo-api\"}[$__rate_interval])) * 60",
          "legendFormat": "Completed",
          "refId": "B",
          "exemplar": true
        },
        {
          "expr": "sum(rate(orders_failed_total{job=\"demo-api\"}[$__rate_interval])) * 60",
          "legendFormat": "Failed",
          "refId": "C",
          "exemplar": true
        },
        {
          "expr": "sum(rate(orders_cancelled_total{job=\"demo-api\"}[$__rate_interval])) * 60",
          "legendFormat": "Cancelled",
          "refId": "D",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "title": "Revenue by Product over Time",
